# Security and hosting configuration
# TLS / HTTPS
TLS_ONLY=true
TLS_MIN_VERSION=TLS1_3
HSTS_MAX_AGE=31536000
HSTS_PRELOAD=true
HSTS_INCLUDE_SUBDOMAINS=true

# KMS / key management
KMS_PROVIDER=aws-kms
KMS_KEY_ID=
KMS_KEY_VERSION=latest
KMS_REGION=

# Application secrets
HMAC_SECRET=
SESSION_SECRET=
ADMIN_MFA_ISSUER=KaziRemote

# Public key / encryption material
DATA_KEY_HEX=

# Optional local dev certs
TLS_CERT_PATH=
TLS_KEY_PATH=
